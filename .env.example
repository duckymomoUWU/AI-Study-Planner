# Copy this file to .env at the repository root. Never commit the real .env.
# Plain KEY=value format; do not wrap values in quotes or use "export".
# Database: these defaults match compose.yml. Choose your own password.
DB_PASSWORD=
DB_USER=study_planner
DB_URL=jdbc:postgresql://localhost:5432/study_planner

# Backend HTTP port. Vite defaults to proxying to port 8080.
PORT=8080
SESSION_COOKIE_SECURE=false

# Gemini credentials: backend only. Fill the key locally or share privately.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Google Calendar OAuth (Google Cloud: Web application client, Calendar API enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/calendar/oauth/callback
APP_URL=http://127.0.0.1:5173
# Stable base64 encoding of 32 random bytes. Keep private and back up with the DB.
# Generate locally: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CALENDAR_TOKEN_KEY=
