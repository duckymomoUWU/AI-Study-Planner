// Reference only. Copy to frontend/src/pages/StudyTimerPage.jsx and implement the full Timer AC.
// API below is NEW/proposed. This skeleton does not implement a countdown or save study time.
import { useEffect, useState } from 'react'
import { getActiveSession } from '../lib/studySessions.js'
import './StudyTimerPage.css'

export default function StudyTimerPage({ currentUser, onNavigateAuth, onNavigateGoals }) {
  const [session, setSession] = useState(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')
  const [revision, setRevision] = useState(0)

  useEffect(() => {
    if (!currentUser) return
    const controller = new AbortController()
    let active = true
    setLoading(true)
    setError('')
    getActiveSession({ signal: controller.signal })
      .then(value => { if (active) setSession(value) })
      .catch(err => { if (active && err.name !== 'AbortError') setError(err.message) })
      .finally(() => { if (active) setLoading(false) })
    return () => { active = false; controller.abort() }
  }, [currentUser, revision])

  if (!currentUser) return <section className="timer-page">
    <h1>Phiên tập trung</h1><p>Đăng nhập để lưu thời gian học của bạn.</p>
    <button className="button button--primary" onClick={onNavigateAuth}>Đăng nhập</button>
  </section>

  return <section className="timer-page" aria-labelledby="timer-title">
    <header><h1 id="timer-title">Phiên tập trung</h1><p>Một công việc, một khoảng tập trung.</p></header>
    {loading && <p role="status">Đang tải phiên học…</p>}
    {error && <div role="alert"><p>{error}</p><button onClick={() => setRevision(value => value + 1)}>Thử lại</button></div>}
    {!loading && !error && !session && <div className="timer-card">
      <h2>Chọn một việc để bắt đầu</h2><p>Bạn chưa có phiên học đang mở.</p>
      <button className="button button--primary" onClick={onNavigateGoals}>Xem mục tiêu</button>
    </div>}
    {!loading && !error && session && <article className="timer-card">
      <h2>{session.taskTitle}</h2><p>{session.subject}</p>
      {/* Implement the contract state machine and monotonic countdown; do not expose raw status in final UI. */}
      <p>Còn {session.remainingSeconds} giây trong snapshot máy chủ.</p>
    </article>}
  </section>
}
