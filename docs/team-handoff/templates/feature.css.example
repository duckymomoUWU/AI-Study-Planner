/* Copy into StudyTimerPage.css; scope selectors to the module. */
.timer-page { max-width: 1080px; margin: 0 auto; padding: 24px; color: var(--ink); }
.timer-page header { margin-bottom: 24px; }
.timer-page h1 { font-family: var(--font-ui); font-size: clamp(28px, 4vw, 38px); line-height: 1.5; }
.timer-page p { margin-top: 8px; line-height: 1.7; color: var(--muted); }
.timer-card { margin-top: 16px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
.timer-page button { min-height: 44px; margin-top: 16px; padding: 10px 16px; border-radius: 12px; font: inherit; }
.timer-page button:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; }
@media (max-width: 600px) { .timer-page { padding: 16px; } .timer-card { padding: 18px; } }
